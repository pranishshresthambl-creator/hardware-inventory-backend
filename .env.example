# Django Settings
SECRET_KEY=change-this-to-a-very-long-and-random-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
CORS_ALLOWED_ORIGINS=

# PostgreSQL Database Connection
POSTGRES_DB=nrb_hardware_db
POSTGRES_USER=nrb_user
POSTGRES_PASSWORD=nrb_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
CONN_MAX_AGE=600

# Gunicorn Workers
GUNICORN_WORKERS=3
